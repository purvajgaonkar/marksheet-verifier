# =====================================================================
# Marksheet Verifier - backend environment configuration (EXAMPLE)
# =====================================================================
# Copy this file to  backend/.env  and fill in your values.
#
#   * This .env.example file MAY be committed (it has no secrets).
#   * backend/.env  must NEVER be committed (it is git-ignored).
#   * The app works WITHOUT the Claude key: it falls back to the local
#     retrieval assistant (Phase 6). The Claude API is OPTIONAL.
#   * For local development you can leave every value at its default.
# ---------------------------------------------------------------------

# --- Database (Phase 8) ----------------------------------------------
# Default is a local SQLite file (no setup needed). The app is also
# PostgreSQL-ready: point DATABASE_URL at a Postgres instance, e.g.
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/marksheet
DATABASE_URL=sqlite:///./marksheet_verifier.db

# --- Optional Claude API mode (Phase 7) ------------------------------
# Your Anthropic API key. Leave as-is (or unset) to stay in local fallback mode.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Use a CURRENT model id. ("claude-3-5-sonnet-latest" is retired -> 404.)
ANTHROPIC_MODEL=claude-sonnet-4-6
# Master switch. "false" = always use the local fallback assistant.
LLM_ENABLED=false
# Maximum tokens Claude may generate per answer.
LLM_MAX_TOKENS=900

# --- Authentication (Phase 9, JWT) -----------------------------------
# CHANGE JWT_SECRET_KEY to a long random string for any real deployment.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# One-time first-admin bootstrap secret (Phase 10). Required by
# POST /auth/setup-admin to create the first admin after a fresh deploy.
# Leave blank/placeholder to keep that endpoint disabled (local dev uses
# create_admin.py instead). NEVER commit or share the real value.
SETUP_SECRET=change_this_to_a_long_random_setup_secret

# --- Deployment URLs / environment (Phase 10) ------------------------
# ENVIRONMENT: "development" (permissive local CORS) or "production"
# (CORS restricted to FRONTEND_URL; error details are hidden).
# FRONTEND_URL may be a comma-separated list, e.g.
#   FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
ENVIRONMENT=development

# --- Upload limits (Phase 10) ----------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg

# --- Heavy image forensics (Phase 11 deployment toggle) --------------
# The OpenCV pixel-forensics step is CPU/memory-heavy. On tiny free-tier
# instances it can starve the CPU and cause the host to restart the app
# mid-upload. Keep it ON locally; set to false on small free hosts (OCR,
# metadata, agents, risk scoring, and Claude still work).
FORENSICS_ENABLED=true
