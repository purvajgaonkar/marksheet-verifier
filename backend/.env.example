# =====================================================================
# Marksheet Verifier - backend environment configuration (EXAMPLE)
# =====================================================================
# Copy this file to  backend/.env  and fill in your values.
#
#   * This .env.example file MAY be committed (it has no secrets).
#   * backend/.env  must NEVER be committed (it is git-ignored).
#   * The app works WITHOUT any of these set: it falls back to the local
#     retrieval assistant (Phase 6). The Claude API is OPTIONAL.
# ---------------------------------------------------------------------

# Your Anthropic API key. Leave as-is (or unset) to stay in local fallback mode.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Which Claude model to use when LLM mode is on.
# Use a CURRENT model id. ("claude-3-5-sonnet-latest" is retired -> 404.)
# Good options: claude-sonnet-4-6 (balanced), claude-haiku-4-5 (cheap/fast),
# claude-opus-4-8 (most capable).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Master switch. "false" = always use the local fallback assistant.
# Set to "true" AND provide a valid ANTHROPIC_API_KEY to enable Claude RAG mode.
LLM_ENABLED=false

# Maximum tokens Claude may generate per answer.
LLM_MAX_TOKENS=900
