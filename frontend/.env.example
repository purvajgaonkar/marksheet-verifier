# =====================================================================
# Marksheet Verifier - frontend environment configuration (EXAMPLE)
# =====================================================================
# Copy this file to  frontend/.env  and adjust if needed.
#
#   * This .env.example MAY be committed (no secrets).
#   * frontend/.env must NOT be committed (it is git-ignored).
#   * Vite only exposes variables prefixed with VITE_ to the browser.
#   * NEVER put API keys or other secrets in a frontend .env — anything
#     here is shipped to the browser and is public.
# ---------------------------------------------------------------------

# Base URL of the backend API.
#   Local development:  http://127.0.0.1:8000
#   Production:         https://your-backend.onrender.com  (for example)
VITE_API_BASE_URL=http://127.0.0.1:8000
